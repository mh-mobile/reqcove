diff --git a/tsnet/fallbackudp_test.go b/tsnet/fallbackudp_test.go
new file mode 100644
index 0000000..fc02990
--- /dev/null
+++ b/tsnet/fallbackudp_test.go
@@ -0,0 +1,102 @@
+package tsnet
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"testing"
+	"time"
+
+	"tailscale.com/ipn"
+	"tailscale.com/ipn/store/mem"
+	"tailscale.com/net/tsaddr"
+	"tailscale.com/tailcfg"
+	"tailscale.com/tstest"
+	"tailscale.com/util/must"
+)
+
+// TestFallbackUDPThroughExitNode checks that UDP sent through an exit node
+// reaches Server.FallbackUDP with the client's source and the original
+// destination, and that UDP addressed to the exit node itself never does.
+func TestFallbackUDPThroughExitNode(t *testing.T) {
+	tstest.ResourceCheck(t)
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+
+	type flow struct{ src, dst netip.AddrPort }
+	calls := make(chan flow, 16)
+
+	controlURL, c := startControl(t)
+	s1 := &Server{
+		Dir:        t.TempDir(),
+		ControlURL: controlURL,
+		Hostname:   "s1",
+		Store:      new(mem.Store),
+		Ephemeral:  true,
+		FallbackUDP: func(src, dst netip.AddrPort) bool {
+			calls <- flow{src, dst}
+			return false // drop: don't send test packets to the internet
+		},
+	}
+	t.Cleanup(func() { s1.Close() })
+	s1status, err := s1.Up(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s1ip := s1status.TailscaleIPs[0]
+	s1PubKey := s1status.Self.PublicKey
+
+	lc1 := must.Get(s1.LocalClient())
+	must.Get(lc1.EditPrefs(ctx, &ipn.MaskedPrefs{
+		Prefs:              ipn.Prefs{AdvertiseRoutes: tsaddr.ExitRoutes()},
+		AdvertiseRoutesSet: true,
+	}))
+	c.SetSubnetRoutes(s1PubKey, tsaddr.ExitRoutes())
+
+	s2, s2ip, _ := startServer(t, ctx, controlURL, "s2")
+	lc2 := must.Get(s2.LocalClient())
+	pingCtx, cancelPing := pingTimeout(ctx)
+	defer cancelPing()
+	must.Get(lc2.Ping(pingCtx, s1ip, tailcfg.PingTSMP))
+	must.Get(lc2.EditPrefs(ctx, &ipn.MaskedPrefs{
+		Prefs:         ipn.Prefs{ExitNodeID: c.Node(s1PubKey).StableID},
+		ExitNodeIDSet: true,
+	}))
+
+	dst := netip.MustParseAddrPort("203.0.113.42:9") // TEST-NET-3
+	if err := tstest.WaitFor(30*time.Second, func() error {
+		p, ok := s2.lb.PeerForIP(dst.Addr())
+		if !ok || p.Node.Key() != s1PubKey {
+			return fmt.Errorf("exit route via s1 not installed yet")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	send := func(to netip.AddrPort) {
+		conn, err := s2.Dial(ctx, "udp", to.String())
+		if err != nil {
+			t.Fatalf("s2.Dial(udp, %v): %v", to, err)
+		}
+		defer conn.Close()
+		if _, err := conn.Write([]byte("hello")); err != nil {
+			t.Fatalf("write to %v: %v", to, err)
+		}
+	}
+
+	// UDP to s1's own address with no listener must not be offered.
+	send(netip.AddrPortFrom(s1ip, 9999))
+	send(dst)
+	select {
+	case f := <-calls:
+		if f.dst != dst {
+			t.Fatalf("FallbackUDP got dst %v; want %v (self-addressed UDP must not be offered)", f.dst, dst)
+		}
+		if f.src.Addr() != s2ip {
+			t.Errorf("FallbackUDP got src %v; want s2 %v", f.src, s2ip)
+		}
+	case <-ctx.Done():
+		t.Fatal("FallbackUDP was not called for UDP through the exit node")
+	}
+}
diff --git a/tsnet/tsnet.go b/tsnet/tsnet.go
index adf5ff5..bc0ae87 100644
--- a/tsnet/tsnet.go
+++ b/tsnet/tsnet.go
@@ -267,6 +267,16 @@ type Server struct {
 	// If unset, logs are discarded.
 	Logf logger.Logf
 
+	// FallbackUDP, if non-nil, is called for each new UDP flow that no
+	// listener handles and that is not addressed to this node, such as
+	// traffic routed through this node as an exit node or subnet router.
+	// Returning true lets netstack forward the flow to dst from this host;
+	// returning false drops it, which is also the behavior when nil.
+	//
+	// It is called synchronously from netstack's packet processing, so it
+	// must not block. It must be set before Start and not changed after.
+	FallbackUDP func(src, dst netip.AddrPort) (forward bool)
+
 	// Ephemeral, if true, specifies that the instance should register
 	// as an Ephemeral node (https://tailscale.com/s/ephemeral-nodes).
 	Ephemeral bool
@@ -1321,11 +1331,23 @@ func (s *Server) getTCPHandlerForFlow(src, dst netip.AddrPort) (handler func(net
 func (s *Server) getUDPHandlerForFlow(src, dst netip.AddrPort) (handler func(nettype.ConnPacketConn), intercept bool) {
 	ln, ok := s.listenerForDstAddr("udp", dst, false)
 	if !ok {
+		// Forwarding a flow addressed to this node would send it to the
+		// host's loopback, so only offer FallbackUDP the others.
+		if s.FallbackUDP != nil && !s.isSelfAddr(dst.Addr()) && s.FallbackUDP(src, dst) {
+			return nil, false // let netstack forward it
+		}
 		return nil, true // don't handle, don't forward to localhost
 	}
 	return func(c nettype.ConnPacketConn) { ln.handle(c) }, true
 }
 
+// isSelfAddr reports whether ip is one of this node's Tailscale IPs.
+func (s *Server) isSelfAddr(ip netip.Addr) bool {
+	ip4, ip6 := s.TailscaleIPs()
+	ip = ip.Unmap()
+	return ip == ip4 || ip == ip6
+}
+
 // Listen announces only on the Tailscale network.
 // It will start the server if it has not been started yet.
 //
