@@ -562,6 +568,9 @@ func (r *Resolver) HandlePeerDNSQuery(ctx context.Context, q []byte, from netip.
 	select {
 	case p, ok := <-ch:
 		if ok {
+			if restoreID && len(p.Bs) >= 2 {
